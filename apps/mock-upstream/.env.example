# ---- server -----------------------------------------------------------------
MOCK_UPSTREAM_PORT=4010    # Render: set to 10000 (Render's PORT is not read)
MOCK_UPSTREAM_MODE=ok      # ok | stream | error500 | slow-first-byte | slow-stream | no-usage | malformed | stream-no-done

# ---- auth -------------------------------------------------------------------
# Bearer the mock requires; the api's upstream key must match. Leave commented
# out to accept any non-empty bearer (local dev only). Never set it empty.
# MOCK_UPSTREAM_API_KEY=replace-me

# ---- keep-alive -------------------------------------------------------------
# Pings <url>/healthz every 30s. Falls back to RENDER_EXTERNAL_URL, which
# Render sets automatically; unset both to disable.
SELF_PING_URL=
