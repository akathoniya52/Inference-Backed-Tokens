# ---- cluster / chain -------------------------------------------------------
CLUSTER=devnet
RPC_URL=https://devnet.helius-rpc.com/?api-key=replace-me
RPC_URL_FALLBACK=https://api.devnet.solana.com
CHAIN_MODE=real            # real | fake
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU # CLUSTER's USDC mint; any other refuses to start

# ---- signing keys (base58 secret keys; NEVER commit real values) -------------
TREASURY_SECRET_KEY=replace-me # only the keeper signs USDC payouts
KEEPER_SECRET_KEY=replace-me   # SOL float, buybacks, locks, migration cranks

# ---- database ---------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/ibt?replicaSet=rs0&directConnection=true

# ---- settlement limits -------------------------------------------------------
SETTLEMENT_CRON="5 * * * *"
RECONCILE_CRON="0 3 * * *"
MAX_SLICE_SOL_PER_RUN=2
MAX_PAYOUT_USDC_PER_RUN=500
FLOAT_MIN_SOL=0.5

# ---- api link ---------------------------------------------------------------
API_INTERNAL_URL=http://localhost:4000
# Same value as the api (at least 32 characters); the keeper uses it for
# POST /api/admin/health-checks/run. Empty disables that job.
ADMIN_TOKEN=
KEEPER_PORT=4001
LOG_LEVEL=info

# ---- pricing ----------------------------------------------------------------
JUPITER_PRICE_URL=https://lite-api.jup.ag/price/v3
JUPITER_API_KEY=

# ---- alerts -----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- keep-alive -------------------------------------------------------------
# Pings <url>/healthz every 30s so an idle free-tier host is not spun down.
# Falls back to RENDER_EXTERNAL_URL, which Render sets on web services; leave
# both empty to disable.
SELF_PING_URL=
RENDER_EXTERNAL_URL=
