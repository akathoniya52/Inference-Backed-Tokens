# ---- cluster / chain -------------------------------------------------------
CLUSTER=devnet
RPC_URL=https://devnet.helius-rpc.com/?api-key=replace-me
RPC_URL_FALLBACK=https://api.devnet.solana.com
CHAIN_MODE=real            # real | fake (fake = in-memory chain for local dev/tests)
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
DBC_CONFIG=replace-me      # from scripts/create-config.ts
TREASURY_WALLET=replace-me # public key; fee claimer and USDC holder
KEEPER_WALLET=replace-me   # public key; shown on /admin/float

# ---- database ---------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/ibt?replicaSet=rs0&directConnection=true

# ---- secrets (32 random bytes each, base64; `openssl rand -base64 32`) ------
JWT_SECRET=replace-me
MASTER_KEY=replace-me
ADMIN_TOKEN=replace-me

# ---- http -------------------------------------------------------------------
NODE_ENV=                  # production requires an explicit TRUST_PROXY (not `true`)
PORT=4000
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000 # = the web's VITE_API_URL; launched tokens' metadata URI is checked against it (required on mainnet)
# Hop count, proxy subnet list (e.g. `10.0.0.0/8`) or false. Defaults to 1 outside
# production; production must set it. With a hop count, a client that reaches the
# port directly can spoof X-Forwarded-For (admin allowlist, IP rate limits).
TRUST_PROXY=1
ADMIN_IP_ALLOWLIST=127.0.0.1,::1 # required on mainnet
RATE_LIMIT_PER_MIN=60
DAILY_CAP_USDC=50
FLOAT_MIN_SOL=0.5          # /api/admin/float flags the keeper float below this

# ---- pricing / upstreams -----------------------------------------------------
JUPITER_PRICE_URL=https://lite-api.jup.ag/price/v3
JUPITER_API_KEY=
MOCK_UPSTREAM_PORT=4010
ALLOW_PRIVATE_UPSTREAMS=false # true lets upstreams resolve to loopback/private IPs (local mock only; refused on mainnet)

# ---- alerts -----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- keep-alive -------------------------------------------------------------
# Pings <url>/healthz every 30s so an idle free-tier host is not spun down.
# Falls back to RENDER_EXTERNAL_URL, which Render sets on web services; leave
# both empty to disable.
SELF_PING_URL=
RENDER_EXTERNAL_URL=
