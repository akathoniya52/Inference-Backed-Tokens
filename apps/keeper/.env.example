# ---- cluster / chain -------------------------------------------------------
CLUSTER=devnet
RPC_URL=https://devnet.helius-rpc.com/?api-key=replace-me
RPC_URL_FALLBACK=https://api.devnet.solana.com
CHAIN_MODE=real            # real | fake
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
DBC_CONFIG=replace-me      # from scripts/create-config.ts
DAMM_V2_FEE_CONFIG=Hv8Lmzmnju6m7kcokVKvwqz7QPmdX9XfKjJsXz8RXcjp
TREASURY_WALLET=replace-me

# ---- signing keys (base58 secret keys; NEVER commit real values) -------------
TREASURY_SECRET_KEY=replace-me # only the keeper signs USDC payouts
KEEPER_SECRET_KEY=replace-me   # SOL float, buybacks, locks, migration cranks

# ---- database ---------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/ibt?replicaSet=rs0&directConnection=true

# ---- settlement limits -------------------------------------------------------
SETTLEMENT_CRON="5 * * * *"
RECONCILE_CRON="0 3 * * *"
MAX_SLICE_SOL_PER_RUN=2
MAX_PAYOUT_USDC_PER_RUN=500
FLOAT_MIN_SOL=0.5

# ---- api link ---------------------------------------------------------------
API_INTERNAL_URL=http://localhost:4000
ADMIN_TOKEN=replace-me     # same value as the api; used for POST /api/admin/health-checks/run
KEEPER_PORT=4001

# ---- pricing ----------------------------------------------------------------
